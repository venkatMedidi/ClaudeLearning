// Changes to apply in force-app/main/default/lwc/cs_PixieWebComponent/cs_PixieWebComponent.js
// (the component is not in this repo, so only the delta is shown).

// 1) Add next to the existing imports
import { ShowToastEvent } from 'lightning/platformShowToastEvent'; // skip if already imported
import validateHipaaForEBV from '@salesforce/apex/CS_eBVHipaaValidator.validateHipaaForEBV';

// 2) Replace the body of initiatePixieCallViaCDC so the HIPAA check runs first
async initiatePixieCallViaCDC() {
    try {
        const validation = await validateHipaaForEBV({ caseId: this.recordId });

        // Scenario 2: Surescripts EP and no Active HIPAA on the Program Case
        if (!validation.isValid) {
            this.dispatchEvent(
                new ShowToastEvent({
                    title: 'Error',
                    message: validation.errorMessage,
                    variant: 'error'
                })
            );
            return;
        }
    } catch (error) {
        this.dispatchEvent(
            new ShowToastEvent({
                title: 'Error',
                message: error?.body?.message || 'Unable to validate HIPAA for eBV.',
                variant: 'error'
            })
        );
        return;
    }

    // Scenarios 1, 3, 4: continue with the existing call, unchanged
    // e.g. initiatePixieCall({ ... existing params ... }).then(...).catch(...);
}
